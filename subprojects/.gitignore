# Ignore everything in subprojects/, including the sources meson downloads and
# the wrap-redirect files it generates for the wraps of StructuredChaos
*

# Keep our own wrap files
!StructuredChaos.wrap
!fastgltf.wrap
!simdjson.wrap

# Keep packagefiles folder and its contents
!packagefiles/
!packagefiles/**

# Keep this .gitignore file
!.gitignore

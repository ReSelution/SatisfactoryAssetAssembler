# .gitignore

# ----------------------------------------
# 1. Proprietäre/Große Binärdateien (Oodle)
# ----------------------------------------
# Diese Dateien dürfen NICHT im Git landen!
liboo2corelinux64.so.*
oo2core_9_win64.dll

#Just in case
*.pak
*.utoc
*.ucas
*.uasset
*.umap

# ----------------------------------------
# 2. CMake/Build-Artefakte
# ----------------------------------------
/build/
/bin/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
cmake-build-*/
/out/



# ----------------------------------------
# 3. Kompiler-Artefakte & Binaries
# ----------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.exp

# ----------------------------------------
# 4. IDEs & Editoren
# ----------------------------------------
# JetBrains (CLion / IDEA)
.idea/*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio (falls mal jemand unter Windows baut)
.vs/
x64/
Debug/
Release/

# ----------------------------------------
# 5. OS spezifischer Müll
# ----------------------------------------
.DS_Store
Thumbs.db

# ----------------------------------------
# 6. Outputs / Logs
# ----------------------------------------
logs/
/output/
*.log
out.txt
perf.data
perf.data.old


# ----------------------------------------
# 7. Python
# ----------------------------------------

.venv/
venv/
